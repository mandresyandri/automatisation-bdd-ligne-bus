; Copier ce fichier en config.ini.
; python load_data.py : ODS -> data/raw/ (iso source) -> data/processed/ (annees en lignes)

[ODS_ACCESS]
portal_url=https://data.seineouest.fr
prefix=/api/explore/v2.1/catalog/datasets/
sufix=/exports/csv?lang=fr&timezone=Europe/Paris&delimiter=%3B&use_labels=false
; cle API ODS (vide pour les jeux publics)
apikey=

; Une section DATASET_<NOM> par jeu ODS. min_year = premiere annee gardee.

[DATASET_FREQUENTATION]
data_name=frequentation-des-lignes-de-bus-locaux-depuis-2014
service_name=bus_frequentation_lignes
min_year=2019

[DATASET_TAUX_REALISATION]
data_name=taux-de-realisation-des-lignes-de-bus-locaux-depuis-2014
service_name=bus_taux_realisation_lignes
min_year=2019
