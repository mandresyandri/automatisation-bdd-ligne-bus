; Modele de configuration.
; Copier ce fichier en config.ini puis le remplir.
; config.ini peut contenir un mot de passe : il est exclu du depot (.gitignore).
;
; MAJ complete (CSV + ArcGIS) : python run.py
; CSV seuls                   : python load_data.py

[ODS_ACCESS]
portal_url=https://data.seineouest.fr
prefix=/api/explore/v2.1/catalog/datasets/
; export CSV : noms techniques des champs (use_labels=false), separateur ;
sufix=/exports/csv?lang=fr&timezone=Europe/Paris&delimiter=%3B&use_labels=false
; cle API ODS (vide pour les jeux publics) : ajoutee automatiquement aux URL
apikey=

[ARCGIS_ACCESS]
; auth=pro     : utilise la session ArcGIS Pro (connecte au portail, "Me connecter automatiquement")
;                -> rien a saisir, ideal pour la tache planifiee. Defaut si username est vide.
; auth=builtin : username + password ci-dessous (ou variable d'environnement ARCGIS_PASSWORD)
auth=pro
; URL du portail (utilisee en auth=builtin) :
;   ArcGIS Online : https://<org>.maps.arcgis.com/
;   Portal        : https://<serveur>/portal
url=https://atlas-sig.seineouest.fr/portal/
username=
password=
; false si le certificat du portail n'est pas reconnu par Python
verify_cert=true
; dossier de contenu du portail ou ranger les tables
folder=Hyperviseur_bus
; partage des tables : everyone | org | private
sharing=everyone
tags=GPSO,bus,hyperviseur,opendata

; Une section DATASET_<NOM> par jeu ODS.
; layer_url est rempli automatiquement par run.py a la creation de la table
; (.../FeatureServer/<index>). Ne pas le modifier ensuite : c'est la table lue par l'hyperviseur.
; Facultatif : min_year (2019 par defaut), id_field, year_field, value_field (voir load_data.py).

[DATASET_FREQUENTATION]
data_name=frequentation-des-lignes-de-bus-locaux-depuis-2014
service_name=bus_frequentation_lignes
title=Frequentation des lignes de bus locaux depuis 2014
min_year=2019
layer_url=

[DATASET_TAUX_REALISATION]
data_name=taux-de-realisation-des-lignes-de-bus-locaux-depuis-2014
service_name=bus_taux_realisation_lignes
title=Taux de realisation des lignes de bus locaux depuis 2014
min_year=2019
layer_url=
